# ---------- 服务 ----------
GATEWAY_PORT=3000
NODE_ENV=development

# ---------- JWT ----------
# 签名密钥。生产必填（openssl rand -hex 32 生成）；
# 开发不填会随机生成一个临时密钥（每次重启登录态失效，正好提醒你去配上）
GATEWAY_JWT_SECRET=
# token 有效期。12h 是「日常使用不用反复登录」和「token 泄露后的暴露窗口」的折中
GATEWAY_JWT_EXPIRES_IN=12h

# ---------- 账号 ----------
# ⚠️ **P2-11c 起降级为「运维后门」**：日常账号的真相源是 MySQL `user` 表，
#    网关登录时把凭据转给后端 `/api/v1/internal/auth/login` 判定。
#    这里剩下的只有 break-glass 超管（连不上库时用）。
# 格式：用户名:bcrypt哈希（多个用英文逗号分隔）
# ⚠️ 只接受 bcrypt 哈希，明文会直接启动失败。
# 生成：npm run hash -- 你的密码
# 不填时（仅开发环境）使用默认账号 admin / admin123
GATEWAY_USERS=

# ---------- 内部接口（P2-11c）----------
# 网关把登录凭据转给后端判定（见 INTERNAL_AUTH_PATH）。
# 判定规则（防枚举文案 / 耗时对齐 / 到期边界 / 锁定 / 强制改密）**只有 Python 一份**
# —— 在这里用 TypeScript 重写一遍就等于把 11b 的铁律破掉，两边迟早漂移。
# 代价是登录多一次内网 HTTP（实测 < 5ms）。
GATEWAY_INTERNAL_AUTH_PATH=/api/v1/internal/auth/login

# ⚠️⚠️ **必须与后端的 INTERNAL_SHARED_SECRET 是同一个值**。
# 不同的症状是「网关登录全挂 401」—— 而原因（两处配置没同步）离症状很远。
#
# ⚠️ **本机裸跑时**（`make gateway`，读的是本文件）**与根目录 `.env` 是一份配置的两个副本**，
#    改了根 `.env` 这里不会跟着变。全栈 compose 模式（`make stack-up`）走
#    `env_file: .env`，只读根目录那份，不受这个问题影响。
#    → 本地裸跑时改完记得两处都改；`make gateway` 启动日志里会打出实际用的是哪条路径。
INTERNAL_SHARED_SECRET=

# 内部接口**不可用**时，是否允许回落到上面的 GATEWAY_USERS。
# ⚠️ 默认 false，生产也建议 false。回落看着「提高可用性」，实际是开了一条
# 绕过 MySQL 的登录通道：内部接口配错时，**所有**账号都改用 `.env` 里那份
# 陈旧数据判定，而且只有一行 warn 日志提示。
# 真正需要它的是本机断网调试 —— 那时设 true 是安全的（外部进不来）。
GATEWAY_INTERNAL_FALLBACK=false

# ---------- 后端 ----------
# 本机开发：http://127.0.0.1:8000
# docker compose：http://backend:8000
# 用 127.0.0.1 而不是 localhost：Node 18+ 会优先把 localhost 解析成 IPv6 ::1，
# 而后端通常只监听 IPv4，会出现「后端明明活着但网关连不上」
GATEWAY_BACKEND_URL=http://127.0.0.1:8000
# 代理超时（毫秒）：必须大于后端链路超时，否则长回答会被网关掐断
# 本地 9B 模型单轮 30~80s，云端 API 通常 5~20s
GATEWAY_PROXY_TIMEOUT_MS=180000

# ---------- 限流 ----------
# 全局：每用户（未登录按 IP）在 TTL 窗口内允许的请求数
GATEWAY_THROTTLE_TTL_MS=60000
GATEWAY_THROTTLE_LIMIT=120
# 登录接口限流写死在代码里（8 次/分钟），不提供配置项：
# 它唯一的用途就是防爆破，调松等于拆掉闸门

# ---------- CORS ----------
# 网关直接面向浏览器的来源白名单，逗号分隔
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 反代信任 ----------
# 仅当网关躲在 Nginx 后面、且 Nginx 用 $remote_addr **覆盖** X-Forwarded-For 时设为 true
# 直连公网时保持 false，否则客户端能伪造 IP 绕过按 IP 的登录限流
GATEWAY_TRUST_PROXY=false
