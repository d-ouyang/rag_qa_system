# 复制为 .env 后填写真实值：cp .env.example .env
# ⚠️ .env 已在 .gitignore 中，切勿提交

PROJECT_NAME=企业级RAG智能问答系统
# 应用版本号 = 项目进度标识。每次功能迭代完成后 +1，与 docs/CHANGELOG.md、
# docs/iterations/ 下的迭代文档一一对应（格式：大版本-阶段.序号）
PROJECT_VERSION=2.0.0-p0.4a

# ---------- 向量库 ----------
VECTOR_STORE_TYPE=chroma          # chroma | faiss（推荐 chroma，删除文档更省心）
EMBEDDING_MODEL_NAME=bge_small_zh # 对应 models/bge_small_zh
EMBEDDING_DEVICE=cpu              # Mac 可用 mps（Apple Silicon 加速）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- 检索 ----------
SEARCH_TOP_K=5
USE_RERANKER=true
RERANKER_MODEL_NAME=bge_reranker_base

# ---------- LLM ----------
# ollama（本地，无需联网、无费用）| siliconflow（云端，快）| openai
LLM_PROVIDER=ollama

# 本地 Ollama（服务需先启动：Ollama.app 或 ollama serve）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3.5:9b      # 本机已拉取；想更快可换 qwen2.5:7b-instruct-q4_K_M

# 硅基流动（OpenAI 兼容）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# CORS 白名单（⚠️ 必须是 JSON 数组格式，pydantic-settings 按 JSON 解析 list 类型；
# Vue 开发端口 5173 必须加，否则浏览器请求被 CORS 拦截）
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8501","http://localhost:3000"]

# ---------- 会话记忆存储（v2.0.0）----------
# memory：进程内 dict（本地开发 / 测试；重启即丢，但零依赖，CI 友好）
# mysql ：会话 / 消息 / 用量 / 引用落 MySQL，重启不丢（生产真相源，P0-1 起可用）
# 本地开发保持 memory 即可 —— 不必为了跑测试先起 MySQL；切换只改这一行 + 重启后端。
MEMORY_BACKEND=memory
# 单个会话序列化后的体积上限（字节）。防「粘贴长文档」把单会话撑成大 key
MEMORY_MAX_SESSION_BYTES=262144

# ---------- MySQL（业务数据真相源，2026-09-23 起）----------
# 本地开发：`make infra` 起容器（docker compose up -d mysql redis），应用裸跑 → HOST=localhost
# 全栈容器化（P1-5b）：服务间走容器网络 → HOST 改为 mysql
# ⚠️ HOST 必须走变量，不要在代码里硬编码 localhost —— 否则两种模式切换时必漏改一处，
#    而症状是「连不上数据库」这种低信息量报错。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rag_qa
MYSQL_USER=rag
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# ---------- Redis（队列 broker + 短期缓存）----------
# 定位（2026-09-23 修订）：Redis **不是业务真相源**，只做队列与短期缓存。
# 会话 / 消息 / 文档元数据的真相源是 MySQL。
REDIS_HOST=localhost
REDIS_PORT=6379
# db0：缓存类（P3 的问答字符串缓存、SSE 碎片）
REDIS_URL=redis://localhost:6379/0
# db1：文档解析队列 broker（P0-3 启用）。与缓存分库，便于单独看积压 / 单独清理
REDIS_QUEUE_URL=redis://localhost:6379/1
# 所有本应用 key 统一前缀：rag:session:{id} / rag:sessions / rag:lock:{id}
REDIS_KEY_PREFIX=rag
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
# 会话级分布式锁（多 worker / 多容器下保证同一会话串行）
# ⚠️ deprecated：仅 RedisSessionStore（已退出生产路径）还读这三项。
#    生产路径的会话级锁由 MySQL SELECT ... FOR UPDATE 承担（见 P0-1）。
REDIS_LOCK_ENABLED=true
REDIS_LOCK_TTL_MS=5000
REDIS_LOCK_WAIT_MS=2000

# ---------- 文档解析异步链路（v2.0.0 P0-3）----------
# 把「解析 → 切分 → 嵌入 → 写 Chroma」从 HTTP 请求挪到独立进程（Celery worker）。
# 任务状态真相源是 MySQL `document.status`；下面两项只管队列与超时。
# 单文件上传上限（字节）。默认 50MB
DOC_UPLOAD_MAX_BYTES=52428800
# 队列名。显式命名而不吃 Celery 默认的 "celery"，否则将来多队列时 LLEN 观测会串味
TASK_QUEUE_NAME=rag.parse
# 硬超时：到点 SIGKILL，防坏文件把 worker 卡死
TASK_TIME_LIMIT_SECONDS=600
# 软超时：比硬超时早一步抛异常，让任务有机会把状态写成 fail 而不是留下 parsing 僵尸
TASK_SOFT_TIME_LIMIT_SECONDS=540
# 「parsing 太久视为孤儿」的判定秒数。worker 被 kill 后记录会冻在 parsing，
# 没有这个超时就永远捡不回来。取值要明显大于单次解析最长耗时（含模型冷启动）
TASK_STALE_PARSING_SECONDS=900
# worker 并发数与子进程回收阈值（解析 CPU 密集 + 模型吃内存，并发=1 更快）
WORKER_CONCURRENCY=1
WORKER_MAX_TASKS_PER_CHILD=20

# ---------- Redis 内存预警（防本应用把共享 Redis 写爆）----------
REDIS_MEMORY_MONITOR_ENABLED=true
REDIS_MEMORY_CHECK_INTERVAL_SECONDS=60
REDIS_MEMORY_WARN_RATIO=0.70
REDIS_MEMORY_CRITICAL_RATIO=0.85
REDIS_MEMORY_FATAL_RATIO=0.95
# Redis 未设 maxmemory（=0）时用于折算水位的假定容量
REDIS_MEMORY_ASSUMED_MAX_MB=128
# fatal 水位下开启只读保护：新会话不写记忆，但问答照常返回（可用性优先）
REDIS_MEMORY_FATAL_READONLY=true
# Redis 写失败时是否降级（true = 丢记忆但问答不中断）
MEMORY_DEGRADE_ON_ERROR=true

# ---------- 鉴权网关（gateway/，NestJS）----------
# 前端所有 /api 请求先到网关，网关校验 JWT 后再转发到本服务。
# 网关侧配置见 gateway/.env.example；后端只信任网关注入的 X-User-Id 头。

LOG_LEVEL=INFO
