.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# 密钥：绝不入库
.env
*.key

# 运行时产物
vector_db/
chroma_data/
upload/
data/*

# 本地项目状态（WorkBuddy 项目记忆/自动化，本地保留、绝不入库）
.workbuddy/
# ⚠️ 例外：检索评测集与评测结果**必须入库**（P3-3）。
#   golden.jsonl 是「尺子」本身 —— 尺子不进版本控制，就没法说明某个数字
#   是哪把尺子量出来的；results/*.json 是 P3-4 A/B 的对照证据。
#   ⚠️ gitignore 的规则是「父目录被排除后不再往下走」，所以这里不能写 `data/`
#   （那样 `!data/eval/` 无效），必须写 `data/*` 把目录本身留着。
!data/eval/
app.log
app.log.*
*.log
.langchain_checkpoints.sqlite*

# 模型权重（用软链共享，不入库）
# 注意：不能写 "models/" —— gitignore 的尾斜杠模式只匹配目录，
# 而软链在 git 里被当成文件（mode 120000），带斜杠会漏掉，导致提交断链 + 泄露本地绝对路径
models

# 前端
web/node_modules/
web/dist/
# 实际 Vue 应用（frontend/）的构建产物与依赖
frontend/node_modules/
frontend/dist/
# TS 增量编译缓存：每次构建都变，入库只会制造无意义的 diff 噪音
*.tsbuildinfo
# 网关（gateway/）自带的 .gitignore 已覆盖 node_modules/ dist/ .env，
# 这里再兜一层，防止将来有人误删那份文件
gateway/node_modules/
gateway/dist/
gateway/.env
.DS_Store

# 种子脚本一次性签发的临时密码（scripts/seed_users.py --credentials-file）。
# 里面是**能直接登录的密码**，绝不能进仓库。
.seed-credentials.csv
*credentials*.csv

# P2-10b：coscli 的失败日志默认写在「当前工作目录」（coscli_output/），
# 手动 sudo 跑备份时会以 root 落在 /opt/qa 下——属主 root 会让部署脚本的
# git clean -fd 删不掉 → 整个 CI/CD 部署 exit 1（2026-10-11 实测翻车一次）。
# 脚本已改用 --log-path 指到 /var/log/qa-backup/，这里再兜底忽略。
coscli_output/
